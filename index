<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mayzal · Cocina de Origen</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;1,300;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--deep:#042524;--teal:#0a3d3b;--teal2:#0f5552;--gold:#e2b57b;--gold2:#f1d3a6;--ivory:#f4ebd9;--violet:#4b3f72;--serif:'Cormorant Garamond',Georgia,'Times New Roman',serif;--sans:'Jost','Helvetica Neue',Arial,sans-serif;color-scheme:dark}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:80px}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--deep);color:var(--ivory);font:300 17px/1.7 var(--sans)}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--gold);outline-offset:4px}
h1,h2,h3{font-family:var(--serif);font-weight:300;margin:0;line-height:1.05}
.wrap{max-width:1180px;margin:0 auto;padding:0 28px}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:20px 36px;background:linear-gradient(var(--deep),transparent)}
nav b{font-family:var(--serif);font-weight:500;letter-spacing:.32em;font-size:20px;color:var(--gold)}
nav div{display:flex;gap:30px;font-size:14px;letter-spacing:.08em}
nav a:hover{color:var(--gold)}
.btn{display:inline-block;border:1px solid var(--gold);color:var(--gold);padding:14px 34px;font-size:14px;letter-spacing:.14em;background:none;cursor:pointer;font-family:var(--sans);transition:background .3s,color .3s}
.btn:hover,.btn.solid{background:var(--gold);color:var(--deep)}
.btn.solid:hover{background:var(--gold2)}
/* hero */
.hero{position:relative;min-height:100vh;min-height:100svh;display:grid;place-items:center;text-align:center;overflow:hidden;background:radial-gradient(ellipse at 50% 45%,var(--teal2),var(--teal) 45%,var(--deep) 100%)}
#field{position:absolute;inset:0;width:100%;height:100%}
.hero .in{position:relative;z-index:2;padding:0 20px;pointer-events:none}
.hero .in a{pointer-events:auto}
.hero h1{font-weight:500;font-size:clamp(58px,13vw,190px);letter-spacing:.06em;color:var(--gold);text-shadow:0 0 60px rgba(226,181,123,.25);animation:rise 1.8s cubic-bezier(.2,.7,.2,1) both}
.hero p.sub{font-size:clamp(14px,1.8vw,19px);letter-spacing:.5em;margin:10px 0 40px;color:var(--gold2);animation:rise 1.8s .5s cubic-bezier(.2,.7,.2,1) both}
.hero .acts{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;animation:rise 1.8s .9s both}
@keyframes rise{from{opacity:0;transform:translateY(28px);letter-spacing:.2em}to{opacity:1;transform:none}}
section{padding:130px 0}
/* filosofia */
.phil{display:grid;grid-template-columns:1.05fr .95fr;gap:80px;align-items:center}
.phil h2{font-size:clamp(40px,5.4vw,74px);color:var(--gold)}
.phil p{max-width:48ch;color:#d9cfbb;font-family:var(--serif);font-size:22px;font-weight:300}
.arch{position:relative;border-radius:600px 600px 8px 8px;overflow:hidden;aspect-ratio:3/4;border:1px solid rgba(226,181,123,.5);padding:12px}
.arch div{width:100%;height:100%;border-radius:600px 600px 4px 4px;background:url(data:image/jpeg;base64,) 52% 50%/cover}
/* menu */
.menu{background:var(--ivory);color:var(--deep)}
.menu h2{font-size:clamp(40px,5.4vw,74px);text-align:center;color:var(--teal)}
.menu .lead{text-align:center;max-width:52ch;margin:18px auto 70px;color:#3b4b49}
.courses{display:grid;grid-template-columns:1fr 1fr;gap:0 90px;max-width:960px;margin:0 auto}
.course{padding:26px 0;border-bottom:1px solid rgba(10,61,59,.25)}
.course h3{font-size:30px;font-weight:500;color:var(--teal)}
.course span{font-size:15px;color:#52625f}
.menu .note{text-align:center;margin-top:50px;font-family:var(--serif);font-style:italic;font-size:22px;color:var(--violet)}
/* galeria */
.gal h2,.ev h2{font-size:clamp(40px,5.4vw,74px);color:var(--gold);margin-bottom:50px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:230px;gap:14px}
.tile{position:relative;overflow:hidden;background-size:cover;background-position:center}
.tile::after{content:attr(data-t);position:absolute;left:0;right:0;bottom:0;padding:38px 18px 14px;background:linear-gradient(transparent,rgba(4,37,36,.85));font-family:var(--serif);font-size:21px;font-style:italic;color:var(--gold2);opacity:0;transform:translateY(10px);transition:.4s}
.tile:hover::after,.tile:focus-visible::after{opacity:1;transform:none}
.tile{transition:transform .6s}.tile:hover{transform:scale(.985)}
.t1{grid-column:span 2;grid-row:span 2;background-image:url(data:image/jpeg;base64,)}
.t2{background-image:url(data:image/jpeg;base64,);background-size:260%;background-position:48% 52%}
.t3{background:radial-gradient(circle at 30% 30%,#6b5aa6,var(--violet) 60%,#241c40)}
.t4{grid-row:span 2;background:linear-gradient(160deg,var(--gold),#a8742f)}
.t5{background:radial-gradient(circle at 70% 70%,var(--teal2),var(--teal))}
.t6{grid-column:span 2;background-image:url(data:image/jpeg;base64,);background-size:170%;background-position:20% 85%}
.t3,.t4,.t5{background-image:radial-gradient(rgba(255,255,255,.18) 2px,transparent 2.5px),var(--g,none);background-size:22px 22px,cover}
.t3{--g:radial-gradient(circle at 30% 30%,#6b5aa6,#4b3f72 60%,#241c40)}.t4{--g:linear-gradient(160deg,#e2b57b,#a8742f)}.t5{--g:radial-gradient(circle at 70% 70%,#0f5552,#0a3d3b)}
.gnote{margin-top:16px;font-size:14px;color:#9fb3ae}
/* eventos */
.ev{background:linear-gradient(var(--deep),var(--teal) 50%,var(--deep))}
.ev .lead{max-width:56ch;margin:-20px 0 50px;color:#d9cfbb}
details{border-top:1px solid rgba(226,181,123,.35)}
details:last-of-type{border-bottom:1px solid rgba(226,181,123,.35)}
summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:30px 4px;font-family:var(--serif);font-size:clamp(30px,4vw,52px);transition:color .3s,padding .3s}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-family:var(--sans);font-weight:200;font-size:36px;color:var(--gold);transition:transform .4s}
details[open] summary::after{transform:rotate(45deg)}
summary:hover{color:var(--gold);padding-left:16px}
details p{margin:0 0 34px;padding:0 4px;max-width:62ch;color:#d9cfbb;animation:rise .6s both}
/* reservas */
.res{text-align:center;background:var(--ivory);color:var(--deep)}
.res h2{font-size:clamp(40px,5.4vw,74px);color:var(--teal)}
.res p{max-width:46ch;margin:16px auto 44px;color:#3b4b49}
.fields{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:900px;margin:0 auto 34px;text-align:left}
label{font-size:13px;letter-spacing:.06em;color:#52625f;display:block}
input,select{width:100%;margin-top:6px;padding:12px 2px;border:0;border-bottom:1px solid var(--teal);background:none;font:400 17px var(--sans);color:var(--deep)}
.res .btn{color:var(--teal);border-color:var(--teal)}.res .btn:hover,.res .btn.solid{background:var(--teal);color:var(--ivory)}
footer{padding:70px 0 50px;text-align:center;color:#b9c9c4;font-size:15px}
footer b{display:block;font-family:var(--serif);font-weight:500;font-size:34px;letter-spacing:.3em;color:var(--gold);margin-bottom:6px}
@media(max-width:860px){nav div a:not(.btn){display:none}nav{padding:16px 20px}.phil{grid-template-columns:1fr;gap:50px}.courses{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr;grid-auto-rows:170px}.t1,.t6{grid-column:span 2}.fields{grid-template-columns:1fr 1fr}section{padding:90px 0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style></head><body>
<nav><b>MAYZAL</b><div><a href="#filosofia">Origen</a><a href="#menu">Menú</a><a href="#galeria">Galería</a><a href="#eventos">Eventos</a><a href="#reservar" class="btn" style="padding:8px 22px">Reservar</a></div></nav>

<header class="hero"><canvas id="field" aria-hidden="true"></canvas>
<div class="in"><h1>Mayzal</h1><p class="sub">Cocina de origen</p>
<div class="acts"><a class="btn solid" href="#reservar">Reservar mesa</a><a class="btn" href="#menu">Ver el menú</a></div></div></header>

<section id="filosofia"><div class="wrap phil"><div>
<h2>Todo empieza en un grano</h2>
<p style="margin-top:34px">Hace miles de años, el maíz nació de la tierra y de las manos que lo cuidaron. En Mayzal volvemos a esa raíz: maíces nativos nixtamalizados en casa, tortillas azules hechas al momento y técnicas de fuego y paciencia que honran a quien sembró primero.</p>
<p>Cada plato es un viaje corto desde la milpa hasta tu mesa, servido con la precisión de una cocina de autor.</p></div>
<div class="arch" role="img" aria-label="Taco de cochinita sobre tortilla de maíz azul con flor comestible"><div></div></div></div></section>

<section id="menu" class="menu"><div class="wrap">
<h2>Menú degustación</h2>
<p class="lead">Siete tiempos que recorren el maíz en todas sus formas. Maridaje opcional con vinos mexicanos y destilados de agave.</p>
<div class="courses">
<div class="course"><h3>Taco de maíz azul</h3><span>Cochinita pibil, cebolla morada encurtida, flor comestible</span></div>
<div class="course"><h3>Esquite ahumado</h3><span>Elote de la casa, mantequilla de chile, polvo de chicatana</span></div>
<div class="course"><h3>Tlacoyo de haba</h3><span>Masa criolla, hoja santa, queso de rancho</span></div>
<div class="course"><h3>Caldo de milpa</h3><span>Calabaza, flor de calabaza, epazote en espuma</span></div>
<div class="course"><h3>Pescado a las brasas</h3><span>Salsa de huitlacoche, tortilla crujiente de maíz rojo</span></div>
<div class="course"><h3>Mole negro de Origen</h3><span>Pato confitado, siete chiles, masa tostada</span></div>
<div class="course" style="grid-column:1/-1;text-align:center"><h3>Elote en postre</h3><span>Helado de maíz tierno, caramelo de piloncillo, pétalos de oro</span></div>
</div><p class="note">El menú cambia con la cosecha.</p></div></section>

<section id="galeria" class="gal"><div class="wrap"><h2>Galería</h2>
<div class="grid">
<div class="tile t1" data-t="Taco de maíz azul" tabindex="0"></div>
<div class="tile t2" data-t="Flor de temporada" tabindex="0"></div>
<div class="tile t3" data-t="Maíz morado" tabindex="0"></div>
<div class="tile t4" data-t="Fuego y grano" tabindex="0"></div>
<div class="tile t5" data-t="La milpa" tabindex="0"></div>
<div class="tile t6" data-t="Mesa servida" tabindex="0"></div>
</div><p class="gnote">Los mosaicos de color son espacios para las fotos reales del restaurante.</p></div></section>

<section id="eventos" class="ev"><div class="wrap"><h2>Momentos que se quedan</h2>
<p class="lead">Un salón privado, menús a la medida y un equipo que cuida cada detalle para que tú solo vivas la ocasión.</p>
<details><summary>Pedidas de mano</summary><p>Mesa para dos o para toda la familia, con ambientación de velas y flores de temporada, menú especial y un brindis preparado. Coordinamos el momento exacto con el equipo de sala para que todo salga perfecto.</p></details>
<details><summary>Aniversarios y cumpleaños</summary><p>Cenas íntimas o celebraciones de hasta 40 personas, con menú degustación personalizado y postre con mensaje.</p></details>
<details><summary>Cenas privadas</summary><p>Salón reservado, chef a la vista y maridaje a elegir. Ideal para bodas civiles, despedidas y reuniones familiares.</p></details>
<details><summary>Eventos corporativos</summary><p>Comidas de negocios, lanzamientos y cenas de gala con servicio dedicado, audio y proyección disponibles.</p></details>
</div></section>

<section id="reservar" class="res"><div class="wrap"><h2>Reserva tu mesa</h2>
<p>Cuéntanos la ocasión y te confirmamos en menos de 24 horas.</p>
<div class="fields">
<label>Nombre<input id="n" autocomplete="name"></label>
<label>Fecha<input id="f" type="date"></label>
<label>Personas<select id="p"><option>2</option><option>3</option><option>4</option><option>5 a 8</option><option>9 o más</option></select></label>
<label>Ocasión<select id="o"><option>Cena</option><option>Pedida de mano</option><option>Aniversario</option><option>Evento privado</option></select></label></div>
<button class="btn solid" id="go">Solicitar reservación</button></div></section>

<footer><b>MAYZAL</b>Cocina de origen<br><br>Martes a domingo, 1:00 pm a 11:00 pm · reservas@mayzal.mx</footer>

<script>
(function(){var c=document.getElementById('field'),x=c.getContext('2d'),W,H,D=1,mx=-999,my=-999,t=0,reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
function size(){D=Math.min(devicePixelRatio||1,2);W=c.clientWidth;H=c.clientHeight;c.width=W*D;c.height=H*D;x.setTransform(D,0,0,D,0,0)}
size();addEventListener('resize',size);
var h=c.parentNode;h.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top});
h.addEventListener('pointerleave',function(){mx=my=-999});
function draw(){t+=.012;x.clearRect(0,0,W,H);var s=W<600?30:38;
for(var j=0,y=s/2;y<H+s;y+=s*.9,j++){for(var i=0,px=(j%2?s/2:0);px<W+s;px+=s,i++){
var d=Math.hypot(px-mx,y-my),w=(Math.sin(px*.008+t)+Math.cos(y*.01-t*.8))*.5,g=Math.max(0,1-d/220),a=.05+.05*w+g*.8,r=3+g*7+w*.6;
x.beginPath();x.ellipse(px,y,r*.78,r,0,0,6.283);x.fillStyle='rgba(226,181,123,'+Math.max(.02,a)+')';x.fill()}}
if(!reduce)requestAnimationFrame(draw)}
draw();
document.getElementById('go').onclick=function(){var v=function(i){return document.getElementById(i).value};
location.href='mailto:reservas@mayzal.mx?subject='+encodeURIComponent('Reservación Mayzal')+'&body='+encodeURIComponent('Nombre: '+v('n')+'\nFecha: '+v('f')+'\nPersonas: '+v('p')+'\nOcasión: '+v('o'))}})();
</script></body></html>
